{
  "manifest_version": 3,
  "name": "Hide Reels & Shorts",
  "version": "1.0",
  "description": "Blocks Facebook Reels and YouTube Shorts.",
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*"],
      "js": ["content.js"]
    }
  ]
}
